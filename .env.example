# Conexión a PostgreSQL (Supabase)
# Formato: postgresql://usuario:contrasena@host:puerto/base?pgbouncer=true&connection_limit=1
# Supabase → Project Settings → Database → Connection string → URI (usar el pooler, puerto 6543)
DATABASE_URL="postgresql://usuario:contrasena@aws-0-region.pooler.supabase.com:6543/postgres"

# Puerto del servidor Express
PORT=3000

# Secreto para firmar los JWT (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="cambia-este-valor-por-un-secreto-largo"
